# c3p0 连接池配置模板（复制成 c3p0.properties 再改成自己的数据库账号）
# 真正的 c3p0.properties 里有明文密码，不入库
c3p0.driverClass=com.mysql.cj.jdbc.Driver
c3p0.jdbcUrl=jdbc:mysql://localhost:3306/echo_market?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
c3p0.user=改成你的数据库用户名
c3p0.password=改成你的数据库密码
